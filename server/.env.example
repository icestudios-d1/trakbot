# Copy to .env (gitignored) and fill in real secrets before `docker compose up`.
CYRIL_ADMIN_TOKEN=change-me-long-random-token
CYRIL_AGENT_KEY=change-me-long-random-key
CYRIL_S3_ACCESS_KEY=change-me-s3-access-key
CYRIL_S3_SECRET_KEY=change-me-s3-secret-key
# Optional: the public address of this server, used in the agent install one-liner.
CYRIL_PUBLIC_URL=https://cyril.icestudios.in
